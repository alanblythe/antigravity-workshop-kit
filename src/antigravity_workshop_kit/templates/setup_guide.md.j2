PROJECT_ID="${PROJECT_ID:-{{ first_project_id }}}"
ATTENDEE_EMAIL="attendee@${ORG_DOMAIN:-{{ email_domain }}}"

{% if config.auth_mode == "vertex_paygo" -%}
gcloud projects add-iam-policy-binding "${PROJECT_ID}" \
  --member="user:${ATTENDEE_EMAIL}" \
  --role="roles/aiplatform.user"
{% else -%}
gcloud projects add-iam-policy-binding "${PROJECT_ID}" \
  --member="user:${ATTENDEE_EMAIL}" \
  --role="roles/cloudaicompanion.user"
{% endif %}
gcloud projects add-iam-policy-binding "${PROJECT_ID}" \
  --member="user:${ATTENDEE_EMAIL}" \
  --role="roles/serviceusage.serviceUsageConsumer"
{% if config.enable_cloud_resources %}
gcloud projects add-iam-policy-binding "${PROJECT_ID}" \
  --member="user:${ATTENDEE_EMAIL}" \
  --role="roles/editor"
{% endif -%}
```

